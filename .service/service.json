{
    "tag": ["personal-finance", "filament-admin"],
    "architecture": "linux/amd64",
    "resources": {
        "at_init": {
            "mem_limit": 268435456,
            "disk_space": 2147483648,
            "cpu_period": 100000,
            "cpu_quota": 50000
        },
        "at_most": {
            "mem_limit": 1073741824,
            "disk_space": 5368709120,
            "cpu_period": 100000,
            "cpu_quota": 200000
        }
    },
    "init": {
        "entry_path": ["usr", "local", "bin", "start.sh"]
    },
    "api": [
        {
            "port": 8080,
            "transport": "tcp",
            "protocol": ["http1.1", "rest"],
            "mu_per_call": {
                "request": 10
            }
        }
    ],
    "envs": [
        "APP_NAME",
        "APP_ENV",
        "APP_KEY",
        "APP_DEBUG",
        "APP_URL",
        "APP_LOCALE",
        "LOG_CHANNEL",
        "LOG_LEVEL",
        "DB_CONNECTION",
        "DB_HOST",
        "DB_PORT",
        "DB_DATABASE",
        "DB_USERNAME",
        "DB_PASSWORD",
        "SESSION_DRIVER",
        "SESSION_LIFETIME",
        "QUEUE_CONNECTION",
        "CACHE_STORE",
        "MAIL_MAILER",
        "OLLAMA_URL",
        "OLLAMA_OCR_MODEL",
        "OLLAMA_TIMEOUT"
    ],
    "network": [
        {
            "tags": ["ipv4", "private"],
            "prose": "Acceso a la base de datos PostgreSQL (DB_HOST/DB_PORT) y, opcionalmente, a un servidor Ollama para el OCR de tickets (OLLAMA_URL)."
        }
    ]
}
