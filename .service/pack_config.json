{
    "service_dependencies_directory": "__services__",
    "metadata_dependencies_directory": "__metadata__",
    "blocks_directory": "__block__",
    "dependencies": {
        "PF_POSTGRES": "dependencies/pf-postgres"
    },
    "dependencies_env": true,
    "include": [
        "app",
        "bootstrap",
        "config",
        "database",
        "public",
        "resources",
        "routes",
        "artisan",
        "composer.json",
        "composer.lock",
        "agente",
        "docker/agente",
        "docker/chat",
        "docker/servicio",
        ".service/pack_config.json"
    ],
    "ignore": [
        "vendor/",
        "node_modules/",
        "tests/",
        "__pycache__/",
        "*.pyc",
        "*.sqlite*",
        "*.enc",
        ".env",
        ".env.*",
        "storage/",
        "bootstrap/cache/*.php",
        "agente/base/",
        "agente/workspace/",
        "agente/encargos/",
        ".cc-writes/",
        ".git/",
        ".github/"
    ]
}
