{
    "include": [
        "app",
        "bootstrap",
        "config",
        "database",
        "public",
        "resources",
        "routes",
        "scripts",
        "artisan",
        "composer.json",
        "composer.lock",
        ".service/pack_config.json"
    ],
    "ignore": [
        "vendor/",
        "node_modules/",
        "tests/",
        "storage/",
        "*.md",
        ".env",
        ".env.*",
        ".git/",
        ".github/",
        "docker/",
        "docker-compose.yml",
        ".editorconfig",
        ".pytest_cache/",
        "__pycache__/",
        "bootstrap/cache/*.php"
    ]
}
