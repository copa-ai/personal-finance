{
    "service_dependencies_directory": "__services__",
    "metadata_dependencies_directory": "__metadata__",
    "blocks_directory": "__block__",
    "dependencies": {
        "PF_POSTGRES": "dependencies/pf-postgres"
    },
    "dependencies_env": true,
    "include": [
        "app",
        "bootstrap",
        "config",
        "database",
        "public",
        "resources",
        "routes",
        "tests",
        "artisan",
        "composer.json",
        "composer.lock",
        "phpunit.xml",
        "package.json",
        "package-lock.json",
        "vite.config.js",
        "AGENT.md",
        "README.md",
        "agente",
        "dependencies",
        "docker",
        "docs",
        "services",
        ".service/Dockerfile",
        ".service/service.json",
        ".service/pack_config.json",
        ".service/.dockerignore"
    ],
    "ignore": [
        "node_modules/",
        "__pycache__/",
        "*.pyc",
        "*.sqlite*",
        "*.enc",
        ".env",
        ".env.*",
        "storage/",
        "bootstrap/cache/*.php",
        "agente/base/",
        "agente/workspace/",
        "agente/encargos/",
        ".cc-writes/",
        ".git/",
        ".github/"
    ]
}
