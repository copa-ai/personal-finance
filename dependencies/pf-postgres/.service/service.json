{
    "tag": ["pf-postgres", "postgresql"],
    "architecture": "linux/amd64",
    "resources": {
        "at_init": {
            "mem_limit": 268435456,
            "disk_space": 2147483648
        },
        "at_most": {
            "mem_limit": 1073741824,
            "disk_space": 10737418240
        }
    },
    "init": {
        "entry_path": ["usr", "local", "bin", "pf-postgres-start"]
    },
    "api": [
        {
            "port": 5432,
            "transport": "tcp",
            "protocol": ["postgresql"]
        }
    ],
    "envs": ["DB_USERNAME", "DB_PASSWORD", "DB_DATABASE"]
}
