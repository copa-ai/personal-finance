# FrankenPHP (Caddy con PHP embebido), solo HTTP: el TLS lo pone `nodo tunnel`. Escucha en :8080 (service.json -> api).
# Modo clasico (sin worker): 1 nucleo y 1,5 GiB compartidos con el agente, asi que pocos hilos de PHP: uno fijo (el resto se arranca solo
# bajo carga, hasta max_threads) para no tener hilos de PHP ociosos en memoria.
{
	admin off
	auto_https off
	frankenphp {
		num_threads 1
		max_threads 6
	}
}

:8080 {
	root * /opt/finance/app/public
	encode zstd gzip
	# Los tickets son fotos, pero el paquete .celaut.bee del servicio OCR puede pesar cientos de MB (php.ini: 1024M).
	request_body {
		max_size 1100MB
	}
	# Pagina de estado del arranque (estado/servidor.py la sirve mientras la web no existe; aqui, las mismas rutas con los mismos ficheros).
	handle /estado {
		root * /opt/finance/estado
		rewrite * /index.html
		header Cache-Control no-store
		file_server
	}
	handle /estado.json {
		root * /var/lib/finance/publico
		header Cache-Control no-store
		file_server
	}
	handle /memoria.json {
		root * /var/lib/finance/publico
		header Cache-Control no-store
		file_server
	}
	handle /app.log {
		root * /var/lib/finance/publico
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control no-store
		file_server
	}
	# La API interna del chat y de cards NO se sirve por el puerto publico (ni por /interno/chat ni /interno/cards, ni por
	# /index.php/interno/chat, ni con otra mayuscula): solo el sitio de 127.0.0.1:8001. Laravel exige ademas el Bearer CHAT_SECRETO.
	@interno path_regexp interno (?i)interno/
	handle @interno {
		respond "no encontrado" 404
	}
	handle {
		php_server
	}
}

# API interna del chat y de cards (docs/chat-api-interna.md), solo para el traductor gRPC del mismo VM: unicamente /interno/chat/*, /interno/cards/* y solo en el
# loopback. No esta en service.json -> api, asi que `nodo tunnel` no puede llegar a ella. Mismo limite de cuerpo que el contrato
# (archivos de 4 MiB en base64 caben en 8 MiB). Laravel exige ademas el Bearer CHAT_SECRETO.
http://127.0.0.1:8001 {
	bind 127.0.0.1
	root * /opt/finance/app/public
	request_body {
		max_size 8MiB
	}
	handle /interno/chat/* {
		php_server
	}
	handle /interno/cards/* {
		php_server
	}
	handle {
		respond "no encontrado" 404
	}
}
